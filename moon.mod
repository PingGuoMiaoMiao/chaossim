// chaossim — deterministic fault-injection simulation that runs real
// MoonBit state machines instead of hand-rewritten models.

name = "PingGuoMiaoMiao/chaossim"

version = "0.3.0"

readme = "README.md"

repository = "https://github.com/PingGuoMiaoMiao/chaossim"

license = "MIT"

keywords = [
  "deterministic-simulation",
  "fault-injection",
  "testing",
  "concurrency",
  "distributed",
]

preferred_target = "native"

description = "Run your real protocol/handler code under a seeded deterministic scheduler with crash and drop fault plans, and get a replayable trace."
